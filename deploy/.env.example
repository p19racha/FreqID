# ==============================================================================
# FreqID Production Environment Configuration Template
# Copy this file to .env before starting the stack: cp .env.example .env
# For automatic secret generation, run: ./scripts/init.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ingress & Domain Routing (Caddy)
# ------------------------------------------------------------------------------
# Domain name for Caddy automatic HTTPS certificate issuance (Let's Encrypt / ZeroSSL).
# For local HTTP testing without a domain, leave empty or use :80
# For production use your fully qualified domain: freqid.yourdomain.com
DOMAIN_NAME=:80

# Published host ingress ports for Caddy reverse proxy
FREQID_HTTP_PORT=80
FREQID_HTTPS_PORT=443

# Host UID/GID for container permissions (defaults to 1000)
FREQID_UID=1000
FREQID_GID=1000

# Container image release version tag
FREQID_VERSION=0.1.0

# ------------------------------------------------------------------------------
# 2. PostgreSQL Storage Database
# ------------------------------------------------------------------------------
POSTGRES_DB=freqid
POSTGRES_USER=freqid

# Database password used by postgres container and backend connections.
# Automatically generated in deploy/secrets/db_password.txt by ./scripts/init.sh
POSTGRES_PASSWORD=replace_with_strong_database_password_via_init_sh

# ------------------------------------------------------------------------------
# 3. FreqID Server Runtime Configuration
# ------------------------------------------------------------------------------
# Server environment mode: 'production', 'development', or 'test'
FREQID_SERVER_ENVIRONMENT=production

# Biometric inference backend: 'onnx' or 'torch'
FREQID_SERVER_MODEL_BACKEND=onnx

# Path inside the container where PartialFace ONNX weights are mounted
FREQID_SERVER_MODEL_PATH=/app/models/partialface_ir_18.onnx

# Execution hardware target: 'cpu' or 'cuda'
FREQID_SERVER_DEVICE=cpu

# Cosine similarity threshold for 1:1 verification and 1:N identification (Default: 0.35)
FREQID_SERVER_DECISION_THRESHOLD=0.35

# Conceal exact floating-point scores from non-admin responses to prevent hill-climbing
FREQID_SERVER_MASK_SCORES_IN_PRODUCTION=true

# Rate limiting guardrail (requests per minute per client IP)
FREQID_SERVER_RATE_LIMIT_PER_MINUTE=120

# Number of worker threads for parallel feature inference
FREQID_SERVER_MAX_INFERENCE_WORKERS=4
