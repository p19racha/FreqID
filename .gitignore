# Allowlist for documentation / UI assets
!admin-ui/public/favicon.svg

# Secrets & Keys (Forbidden per Git Rule 6)
.env
*.env
!.env.example
!deploy/.env.example
*.pem
*.key
*.p12
*.crt
*.shares
*.mnemonic
id_rsa*
id_ed25519*
deploy/secrets/*
!deploy/secrets/*.example
!deploy/secrets/README.md
!deploy/secrets/.gitkeep
deploy/tls/certs/*
!deploy/tls/certs/*.example
!deploy/tls/certs/README.md
!deploy/tls/certs/.gitkeep
deploy/models/*
!deploy/models/README.md
!deploy/models/.gitkeep

